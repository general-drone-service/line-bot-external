# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Supabase quote-drone168 (same project as quote-page); removed after the move to the CRM
# Accepts either SUPABASE_* or QUOTE_SUPABASE_* naming
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# CRM line-bot-data gateway (bot data in the CRM line_bot schema; HMAC, no DB credentials)
# LINE_BOT_DATA_URL=https://<crm-project>.supabase.co/functions/v1/line-bot-data
# LINE_BOT_DATA_SECRET=
# BOT_DB=quote                         # quote (default) | crm — where chat history / pause / knowledge live

# AI (Claude Haiku)
ANTHROPIC_API_KEY=

# Embeddings (Voyage-3)
VOYAGE_API_KEY=

# Bot auto-reply control
# BOT_PAUSE_HOURS=2                    # Hours to pause after human handoff (default: 2)
# BUSINESS_HOURS_START=9               # Business hours start (default: 9 = 09:00)
# BUSINESS_HOURS_END=18                # Business hours end (default: 18 = 18:00)
# BUSINESS_HOURS_TZ=Asia/Taipei        # Timezone (default: Asia/Taipei)
# BUSINESS_HOURS_DAYS=1,2,3,4,5        # Working days, 0=Sun 6=Sat (default: Mon-Fri)
# BOT_CUTOVER_FREEZE=on                # Only during the bot DB cutover: no AI replies, bot-pause writes return 503

# Human handoff notifications (only configured channels fire; with none, request_human reports a failed handoff)
# MANAGER_LINE_ALERT_URL=https://manager-line.<subdomain>.workers.dev/alert   # LINE push to Teddy
# MANAGER_LINE_ALERT_TOKEN=            # Same value as manager-line's SUPPORT_ALERT_BEARER secret (support-bot only; set by the user)
# NOTIFY_EMAIL_TO=support@drone168.com
# NOTIFY_EMAIL_FROM=linebot@drone168.com
# SENDGRID_API_KEY=
